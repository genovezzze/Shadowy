# PostgreSQL - works with Neon, Supabase, Railway, or local Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/shadowy?schema=public"

# Used to sign session cookies (JWT). Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars-please"

# Cookie config
SESSION_COOKIE_NAME="shadowy_session"
NODE_ENV="development"

# Google OAuth (Sign in with Google) - console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# E-mail sending (password reset). Without RESEND_API_KEY nothing is sent and
# only a warning is logged. Get a key at resend.com.
RESEND_API_KEY=""
EMAIL_FROM="Shadowy <onboarding@resend.dev>"

# Local development only: print the full e-mail body (including reset links) to
# the console when no API key is set. Never enable outside your own machine —
# it puts working password-reset links into the logs.
EMAIL_DEBUG_LOG_BODY=""

# Public URL of the deployed app (used in email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret for Vercel Cron requests to /api/cron/weekly-report.
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Email of the super-admin account (sees all organizations in /superadmin)
SUPERADMIN_EMAIL=""

# Sentry error monitoring (optional). Leave unset to disable.
# DSN from sentry.io project settings (same value for client/server/edge).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Server-only AI parsing for the authenticated smart work log.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"
