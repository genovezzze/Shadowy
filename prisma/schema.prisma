// Shadowy - multi-tenant invisible-work platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum PeriodType {
  WEEK
  TWO_WEEKS
  MONTH
  QUARTER
}

enum RewardType {
  PAID_DAY_OFF
  FLEXIBLE_HOURS
  REMOTE_DAY
  OFFICIAL_RECOGNITION
  THANK_YOU_MESSAGE
  GIFT_CARD
  WORKLOAD_REVIEW
}

enum BonusRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Email notification settings
  emailOnNewEntry      Boolean  @default(true)
  emailOnEntryApproved Boolean  @default(false)
  emailWeeklySummary   Boolean  @default(true)
  emailDailyReminder   Boolean  @default(true)

  // Default hourly rate for cost calculations (EUR)
  defaultHourlyRate Decimal? @db.Decimal(10, 2)

  users            User[]
  entries          InvisibleWorkEntry[]
  categories       Category[]
  clients          Client[]
  workRoles        WorkRole[]
  recognitionRules RecognitionRule[]
  bonusRequests    BonusRequest[]
  notifications    Notification[]
  announcements    Announcement[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String  @unique
  passwordHash String?
  role         Role
  title        String?

  // Individual hourly rate for cost calculations (EUR), overrides role/org default
  hourlyRate Decimal? @db.Decimal(10, 2)

  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?

  /// Sessions are stateless JWTs, so a stolen token stays valid until it expires.
  /// Any token issued before this moment is rejected, which is how a password
  /// change or an explicit "sign out everywhere" revokes existing sessions.
  sessionsValidFrom DateTime?

  managerId String?
  manager   User?   @relation("ManagerEmployees", fields: [managerId], references: [id], onDelete: SetNull)
  employees User[]  @relation("ManagerEmployees")

  canSeeAllClients Boolean @default(false)

  workRoleId       String?
  workRole         WorkRole?  @relation("EmployeeWorkRole", fields: [workRoleId], references: [id], onDelete: SetNull)
  managedWorkRoles WorkRole[] @relation("ManagerWorkRoles")

  submittedEntries  InvisibleWorkEntry[] @relation("EntryEmployee")
  reviewedEntries   InvisibleWorkEntry[] @relation("EntryManager")
  timeLogsCreated   WorkEntryTimeLog[]
  clientAssignments ClientEmployee[]

  managedRecognitionRules RecognitionRule[]    @relation("ManagerRecognitionRules")
  employeeBonusRequests   BonusRequest[]       @relation("EmployeeBonusRequests")
  managerBonusRequests    BonusRequest[]       @relation("ManagerBonusRequests")
  passwordResetTokens     PasswordResetToken[]
  notifications           Notification[]
  createdAnnouncements    Announcement[]       @relation("AnnouncementAuthor")
  announcementReads       AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([managerId])
  @@index([workRoleId])
}

model WorkRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId      String
  manager        User         @relation("ManagerWorkRoles", fields: [managerId], references: [id])

  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)

  // Default hourly rate for employees in this role (EUR)
  defaultHourlyRate Decimal? @db.Decimal(10, 2)

  duties    WorkRoleDuty[]
  employees User[]         @relation("EmployeeWorkRole")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([managerId])
}

model WorkRoleDuty {
  id         String   @id @default(cuid())
  workRoleId String
  workRole   WorkRole @relation(fields: [workRoleId], references: [id], onDelete: Cascade)
  text       String   @db.VarChar(300)
  createdAt  DateTime @default(now())

  @@index([workRoleId])
}

model InvisibleWorkEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeId String
  employee   User   @relation("EntryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  managerId String?
  manager   User?   @relation("EntryManager", fields: [managerId], references: [id], onDelete: SetNull)

  title           String
  category        String
  description     String
  clientName      String?      @db.VarChar(120)
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  workDate        DateTime
  durationMinutes Int

  status         EntryStatus @default(PENDING)
  managerComment String?

  source          String   @default("manual") @db.VarChar(30)
  originalInput   String?  @db.Text
  isOutsideRole   Boolean?
  roleRelation    String?  @db.VarChar(300)
  businessImpact  String?  @db.VarChar(500)
  confidenceScore Float?

  // Soft delete
  deletedAt DateTime?
  deletedBy String?

  timeLogs WorkEntryTimeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([employeeId])
  @@index([managerId])
  @@index([status])
  @@index([clientId])
}

// Tracks failed login attempts for brute-force / password-spray rate limiting.
// Not tenant-scoped: login happens before the organization is known.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([ip, email, createdAt])
}

// Generic IP-based rate limiting for public, unauthenticated actions
// (registration, password reset requests, pilot lead form).
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  ip        String
  createdAt DateTime @default(now())

  @@index([key, ip, createdAt])
}

// Single-use, time-limited password reset tokens. Only a SHA-256 hash of the
// token is stored; the raw token lives only in the emailed reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                String  @db.VarChar(120)
  freeMinutesPerMonth Int?
  status              String  @default("active") @db.VarChar(20)

  entries     InvisibleWorkEntry[]
  assignments ClientEmployee[]
  aliases     ClientAlias[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ClientAlias {
  id             String @id @default(cuid())
  organizationId String
  clientId       String
  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name       String @db.VarChar(120) // display form entered by admin
  normalized String @db.VarChar(160) // normalizeClientName(name) — matching key

  createdAt DateTime @default(now())

  @@unique([organizationId, normalized])
  @@index([clientId])
  @@index([organizationId])
}

model ClientEmployee {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([clientId, employeeId])
  @@index([clientId])
  @@index([employeeId])
}

model WorkEntryTimeLog {
  id      String             @id @default(cuid())
  entryId String
  entry   InvisibleWorkEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  minutes     Int
  comment     String? @db.VarChar(500)
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([createdById])
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  createdAt DateTime @default(now())

  @@unique([organizationId, name])
}

model RecognitionRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId      String
  manager        User         @relation("ManagerRecognitionRules", fields: [managerId], references: [id])

  name             String     @db.VarChar(100)
  description      String?    @db.VarChar(500)
  minimumHours     Float
  periodType       PeriodType
  rewardType       RewardType
  categories       String[]
  workRoleIds      String[]
  oneTimePerPeriod Boolean    @default(true)
  isActive         Boolean    @default(true)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bonusRequests BonusRequest[]

  @@index([organizationId])
  @@index([managerId])
}

model PilotLead {
  id        String   @id @default(cuid())
  name      String
  company   String
  email     String
  teamSize  String
  comment   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model BonusRequest {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       User            @relation("EmployeeBonusRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId      String
  manager        User            @relation("ManagerBonusRequests", fields: [managerId], references: [id], onDelete: Cascade)
  ruleId         String
  rule           RecognitionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  rewardType       RewardType
  status           BonusRequestStatus @default(PENDING)
  hoursAccumulated Float
  employeeComment  String?            @db.VarChar(1000)
  managerComment   String?            @db.VarChar(1000)

  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([employeeId])
  @@index([managerId])
  @@index([ruleId])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  body  String?
  link  String?
  read  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("AnnouncementAuthor", fields: [createdById], references: [id])

  title String @db.VarChar(150)
  body  String @db.Text

  createdAt DateTime @default(now())
  reads     AnnouncementRead[]

  @@index([organizationId, createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}
