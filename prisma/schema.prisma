// Shadowy - multi-tenant invisible-work platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum PeriodType {
  WEEK
  TWO_WEEKS
  MONTH
  QUARTER
}

enum RewardType {
  PAID_DAY_OFF
  FLEXIBLE_HOURS
  REMOTE_DAY
  OFFICIAL_RECOGNITION
  THANK_YOU_MESSAGE
  GIFT_CARD
  WORKLOAD_REVIEW
}

enum BonusRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Email notification settings
  emailOnNewEntry      Boolean @default(true)
  emailOnEntryApproved Boolean @default(false)
  emailWeeklySummary   Boolean @default(true)
  emailDailyReminder   Boolean @default(true)

  // "Komandas vadība" module (recurring client report tasks). Off until the
  // module is switched on for the organisation from the superadmin panel.
  teamTasksEnabled Boolean @default(false)

  // Default hourly rate for cost calculations (EUR)
  defaultHourlyRate Decimal? @db.Decimal(10, 2)

  users            User[]
  entries          InvisibleWorkEntry[]
  categories       Category[]
  clients          Client[]
  workRoles        WorkRole[]
  recognitionRules RecognitionRule[]
  bonusRequests    BonusRequest[]
  notifications    Notification[]
  announcements    Announcement[]
  reportTypes      ReportType[]
  clientReports    ClientReport[]
  clientTasks      ClientTask[]
  clientMonthNotes ClientMonthNote[]
  quickTasks       QuickTask[]
  absences         Absence[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String  @unique
  passwordHash String?
  role         Role
  title        String?

  // Individual hourly rate for cost calculations (EUR), overrides role/org default
  hourlyRate Decimal? @db.Decimal(10, 2)

  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?

  /// Sessions are stateless JWTs, so a stolen token stays valid until it expires.
  /// Any token issued before this moment is rejected, which is how a password
  /// change or an explicit "sign out everywhere" revokes existing sessions.
  sessionsValidFrom DateTime?

  managerId String?
  manager   User?   @relation("ManagerEmployees", fields: [managerId], references: [id], onDelete: SetNull)
  employees User[]  @relation("ManagerEmployees")

  canSeeAllClients Boolean @default(false)

  workRoleId       String?
  workRole         WorkRole?  @relation("EmployeeWorkRole", fields: [workRoleId], references: [id], onDelete: SetNull)
  managedWorkRoles WorkRole[] @relation("ManagerWorkRoles")

  submittedEntries  InvisibleWorkEntry[] @relation("EntryEmployee")
  reviewedEntries   InvisibleWorkEntry[] @relation("EntryManager")
  receivedHelp      InvisibleWorkEntry[] @relation("EntryHelpedUser")
  timeLogsCreated   WorkEntryTimeLog[]
  clientAssignments ClientEmployee[]

  managedRecognitionRules RecognitionRule[]    @relation("ManagerRecognitionRules")
  employeeBonusRequests   BonusRequest[]       @relation("EmployeeBonusRequests")
  managerBonusRequests    BonusRequest[]       @relation("ManagerBonusRequests")
  passwordResetTokens     PasswordResetToken[]
  notifications           Notification[]
  createdAnnouncements    Announcement[]       @relation("AnnouncementAuthor")
  announcementReads       AnnouncementRead[]

  responsibleClients      Client[]          @relation("ClientResponsible")
  responsibleReports      ClientReport[]    @relation("ClientReportResponsible")
  assignedTasks           ClientTask[]      @relation("TaskAssignee")
  completedTasks          ClientTask[]      @relation("TaskCompletedBy")
  updatedClientMonthNotes ClientMonthNote[] @relation("ClientMonthNoteAuthor")
  ownReportTypes          ReportType[]      @relation("ReportTypeOwner")
  quickTasksCreated       QuickTask[]       @relation("QuickTaskCreator")
  quickTasksAssigned      QuickTask[]       @relation("QuickTaskAssignee")
  absences                Absence[]         @relation("AbsenceUser")
  substitutions           Absence[]         @relation("AbsenceSubstitute")
  absencesApproved        Absence[]         @relation("AbsenceApprover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([managerId])
  @@index([workRoleId])
}

model WorkRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId      String
  manager        User         @relation("ManagerWorkRoles", fields: [managerId], references: [id])

  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)

  // Default hourly rate for employees in this role (EUR)
  defaultHourlyRate Decimal? @db.Decimal(10, 2)

  duties    WorkRoleDuty[]
  employees User[]         @relation("EmployeeWorkRole")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([managerId])
}

model WorkRoleDuty {
  id         String   @id @default(cuid())
  workRoleId String
  workRole   WorkRole @relation(fields: [workRoleId], references: [id], onDelete: Cascade)
  text       String   @db.VarChar(300)
  createdAt  DateTime @default(now())

  @@index([workRoleId])
}

model InvisibleWorkEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeId String
  employee   User   @relation("EntryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  managerId String?
  manager   User?   @relation("EntryManager", fields: [managerId], references: [id], onDelete: SetNull)

  title           String
  category        String
  description     String
  clientName      String?  @db.VarChar(120)
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  workDate        DateTime
  durationMinutes Int

  status         EntryStatus @default(PENDING)
  managerComment String?

  source          String  @default("manual") @db.VarChar(30)
  originalInput   String? @db.Text
  roleRelation    String? @db.VarChar(300)
  businessImpact  String? @db.VarChar(500)
  confidenceScore Float?

  isOutsideRole Boolean?

  // Work nature: independent of `category`, which records what was done. An
  // entry can be both bookkeeping and done to cover for a colleague.
  helpedColleague Boolean @default(false)
  helpedUserId    String?
  helpedUser      User?   @relation("EntryHelpedUser", fields: [helpedUserId], references: [id], onDelete: SetNull)

  // Soft delete
  deletedAt DateTime?
  deletedBy String?

  timeLogs WorkEntryTimeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([employeeId])
  @@index([managerId])
  @@index([status])
  @@index([clientId])
  @@index([helpedUserId])
}

// Tracks failed login attempts for brute-force / password-spray rate limiting.
// Not tenant-scoped: login happens before the organization is known.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([ip, email, createdAt])
}

// Generic IP-based rate limiting for public, unauthenticated actions
// (registration, password reset requests, pilot lead form).
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  ip        String
  createdAt DateTime @default(now())

  @@index([key, ip, createdAt])
}

// Single-use, time-limited password reset tokens. Only a SHA-256 hash of the
// token is stored; the raw token lives only in the emailed reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                String @db.VarChar(120)
  freeMinutesPerMonth Int?
  status              String @default("active") @db.VarChar(20)

  // Main responsible person for the client's recurring reports (Komandas vadība).
  // A single report can override it via ClientReport.responsibleUserId.
  responsibleUserId String?
  responsibleUser   User?   @relation("ClientResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  entries     InvisibleWorkEntry[]
  assignments ClientEmployee[]
  aliases     ClientAlias[]
  reports     ClientReport[]
  tasks       ClientTask[]
  monthNotes  ClientMonthNote[]
  quickTasks  QuickTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ClientAlias {
  id             String @id @default(cuid())
  organizationId String
  clientId       String
  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name       String @db.VarChar(120) // display form entered by admin
  normalized String @db.VarChar(160) // normalizeClientName(name) — matching key

  createdAt DateTime @default(now())

  @@unique([organizationId, normalized])
  @@index([clientId])
  @@index([organizationId])
}

model ClientEmployee {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([clientId, employeeId])
  @@index([clientId])
  @@index([employeeId])
}

model WorkEntryTimeLog {
  id      String             @id @default(cuid())
  entryId String
  entry   InvisibleWorkEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  minutes     Int
  comment     String? @db.VarChar(500)
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([createdById])
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  createdAt DateTime @default(now())

  @@unique([organizationId, name])
}

model RecognitionRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId      String
  manager        User         @relation("ManagerRecognitionRules", fields: [managerId], references: [id])

  name             String     @db.VarChar(100)
  description      String?    @db.VarChar(500)
  minimumHours     Float
  periodType       PeriodType
  rewardType       RewardType
  categories       String[]
  workRoleIds      String[]
  oneTimePerPeriod Boolean    @default(true)
  isActive         Boolean    @default(true)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bonusRequests BonusRequest[]

  @@index([organizationId])
  @@index([managerId])
}

model PilotLead {
  id        String   @id @default(cuid())
  name      String
  company   String
  email     String
  teamSize  String
  comment   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model BonusRequest {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       User            @relation("EmployeeBonusRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId      String
  manager        User            @relation("ManagerBonusRequests", fields: [managerId], references: [id], onDelete: Cascade)
  ruleId         String
  rule           RecognitionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  rewardType       RewardType
  status           BonusRequestStatus @default(PENDING)
  hoursAccumulated Float
  employeeComment  String?            @db.VarChar(1000)
  managerComment   String?            @db.VarChar(1000)

  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([employeeId])
  @@index([managerId])
  @@index([ruleId])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  body  String?
  link  String?
  read  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("AnnouncementAuthor", fields: [createdById], references: [id])

  title String @db.VarChar(150)
  body  String @db.Text

  createdAt DateTime           @default(now())
  reads     AnnouncementRead[]

  @@index([organizationId, createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

// ── Komandas vadība: recurring client report tasks ─────────────────────────

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

/// A column of the firm's monthly report sheet ("PVN", "Alga", "KASE"...).
model ReportType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(40)
  /// Null: a firm-wide column set up by a manager. Set: an employee's own
  /// column, part of their personal sheet.
  ownerUserId String?
  owner       User?   @relation("ReportTypeOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// Day of the month the report is due; the deadline moves to the next
  /// working day when it falls on a weekend or a Latvian public holiday.
  dueDay      Int     @default(7)
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  clientReports ClientReport[]
  tasks         ClientTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, ownerUserId, name])
  @@index([organizationId])
  @@index([ownerUserId])
}

/// "This client needs this report" - a white cell of the sheet. No row means
/// the report does not apply to the client (a grey cell).
model ClientReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reportTypeId   String
  reportType     ReportType   @relation(fields: [reportTypeId], references: [id], onDelete: Cascade)

  /// Overrides Client.responsibleUserId for this one report.
  responsibleUserId String?
  responsibleUser   User?   @relation("ClientReportResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  /// "monthly" | "quarterly"
  frequency         String  @default("monthly") @db.VarChar(20)
  /// Overrides ReportType.dueDay for this one report.
  dueDay            Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, reportTypeId])
  @@index([organizationId])
  @@index([reportTypeId])
}

/// One cell of one month: client + report + period.
model ClientTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reportTypeId   String
  reportType     ReportType   @relation(fields: [reportTypeId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// "YYYY-MM"
  period          String     @db.VarChar(7)
  dueDate         DateTime   @db.Date
  /// The deadline as first planned; kept so a late task stays visible as late.
  originalDueDate DateTime   @db.Date
  /// False for reports without a deadline (KASE, Banka...): never late, and
  /// dueDate is just the month's last day for ordering.
  hasDeadline     Boolean    @default(true)
  status          TaskStatus @default(NOT_STARTED)
  completedAt     DateTime?
  completedById   String?
  completedBy     User?      @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  comment         String?    @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, reportTypeId, period])
  @@index([organizationId, period])
  @@index([assigneeId, status])
}

/// The "Info" column: a free note per client per month.
model ClientMonthNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  period         String       @db.VarChar(7)
  text           String       @db.VarChar(500)
  updatedById    String?
  updatedBy      User?        @relation("ClientMonthNoteAuthor", fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([clientId, period])
  @@index([organizationId, period])
}

/// A small to-do instead of a note on paper: "Zvanīt Letex par izrakstu rīt".
model QuickTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User    @relation("QuickTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  /// Who does it; the creator unless it was handed to a colleague.
  assigneeId  String
  assignee    User    @relation("QuickTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  text    String    @db.VarChar(300)
  dueDate DateTime? @db.Date
  done    Boolean   @default(false)
  doneAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([assigneeId, done])
}

/// Time away: vacation, sick leave, or being busy. Colleagues and managers see
/// only the fact and the substitute; the note is private to the person.
model Absence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId       String
  user         User    @relation("AbsenceUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Required for vacation and sick leave (checked in code).
  substituteId String?
  substitute   User?   @relation("AbsenceSubstitute", fields: [substituteId], references: [id], onDelete: SetNull)

  /// "vacation" | "sick" | "busy"
  type         String   @db.VarChar(20)
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  /// Optional hours for a part-day "busy", e.g. "14:00".
  startTime    String?  @db.VarChar(5)
  endTime      String?  @db.VarChar(5)
  /// "planned" | "approved"
  status       String   @default("planned") @db.VarChar(20)
  approvedById String?
  approvedBy   User?    @relation("AbsenceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  /// Private: shown to the person only, never to colleagues or managers.
  note         String?  @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startDate])
  @@index([substituteId])
}
